{
	// Self-hosted Cloudflare Worker config for Temple Property Care.
	// The app is built by `npm run build` (vinext) into ./dist, then deployed
	// with `npm run deploy`. See SELF_HOSTING.md for first-time setup.
	//
	// NOTE: intentionally NOT named "wrangler.jsonc". The Cloudflare Vite plugin
	// used by `npm run dev` auto-discovers a root wrangler.jsonc and merges it
	// with vite.config's dev bindings, which duplicates nodejs_compat and breaks
	// the dev runtime. This non-standard name keeps it deploy-only; the npm
	// scripts pass it explicitly via `wrangler -c wrangler.deploy.jsonc`.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "johntemple",
	"main": "dist/server/index.js",
	"compatibility_date": "2026-05-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// vinext already produced a single bundled worker; don't re-bundle it.
	"no_bundle": true,
	"rules": [
		{
			"type": "ESModule",
			"globs": [
				"**/*.js",
				"**/*.mjs"
			]
		}
	],
	// Static client assets (CSS, JS, fonts, favicon). Non-asset routes fall
	// through to the worker for SSR / API routes.
	"assets": {
		"directory": "dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Lead database. The database_id is created by `wrangler d1 create johntemple-db`.
	// (A D1 database id is an identifier, not a secret — it grants no access
	// without the account API token, which lives only in CI/Cloudflare secrets.)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "johntemple-db",
			"database_id": "881037d3-23b1-40e3-b0db-7846d9c4d64b",
			"migrations_dir": "drizzle"
		}
	],
	// Photo uploads from the quote form.
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "johntemple-photos"
		}
	],
	// Abuse protection for the public /api/quote endpoint: cap submissions per
	// client IP so the form can't be used to flood Twilio (cost) or text
	// arbitrary numbers. 5 requests per 60s per IP.
	"ratelimits": [
		{
			"name": "QUOTE_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	]
}